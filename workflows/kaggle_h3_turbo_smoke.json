{
  "unet": {
    "class_type": "KaggleH3ShardedDiffusionLoader",
    "inputs": {
      "model_variant": "Ref2VA",
      "precision": "int8_convrot",
      "weight_dtype": "default",
      "gpu_0": 0,
      "gpu_1": 1
    },
    "_meta": {"title": "Kaggle H3 | Diffusion Auto Loader (Ref2VA; replaces inactive checkpoint)"}
  },
  "clip": {
    "class_type": "KaggleH3TextEncoderLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device_id": 0
    },
    "_meta": {"title": "Kaggle H3 | Text Encoder (GPU0)"}
  },
  "vae_video": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors",
      "role": "video",
      "device_id": 1
    },
    "_meta": {"title": "Kaggle H3 | Video VAE (GPU1)"}
  },
  "vae_audio": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors",
      "role": "audio",
      "device_id": 0
    },
    "_meta": {"title": "Kaggle H3 | Audio VAE (GPU0)"}
  },
  "character_reference": {
    "class_type": "KaggleH3SmokeReference",
    "inputs": {
      "reference": "character"
    },
    "_meta": {"title": "Reference | Subject Image"}
  },
  "scene_reference": {
    "class_type": "KaggleH3SmokeReference",
    "inputs": {
      "reference": "scene"
    },
    "_meta": {"title": "Reference | Scene Image"}
  },
  "h3": {
    "class_type": "KaggleH3Ref2VAConditioning",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "audio_vae": ["vae_audio", 0],
      "prompt": "Mode: Ref2VA.\nPreserve the subject identity from <Picture 1> and the forest composition from <Picture 2>.\nA short coherent video of the same red-haired traveler in a blue outdoor jacket walking slowly along the forest path at dawn. The camera makes a gentle push-in while mist drifts between the pine trees. The subject's face and body remain stable and consistent, with subtle natural movement in the hair and jacket. Keep the cool blue-green forest light and warm sunrise on the horizon consistent throughout. Natural synchronized ambient forest audio.",
      "seconds": 5.0,
      "size_preset": "360p",
      "aspect_ratio": "16:9",
      "ref_image_size": "match",
      "ref_image_0": ["character_reference", 0],
      "ref_image_1": ["scene_reference", 0]
    },
    "_meta": {"title": "Kaggle H3 | Ref2VA Conditioning (Seconds + Presets)"}
  },
  "h3_adapter": {
    "class_type": "KaggleH3AdapterStack",
    "inputs": {
      "model": ["unet", 0],
      "model_variant": "ref2va",
      "turbo_mode": true,
      "turbo_steps": "4",
      "adapter_1": "h3_ref2va_turbo_4step_v0_1",
      "strength_1": 1.0,
      "adapter_2": "None",
      "strength_2": 1.0,
      "adapter_3": "None",
      "strength_3": 1.0,
      "conditioning_mode": "auto"
    },
    "_meta": {"title": "Kaggle H3 | Turbo + Adapter Stack"}
  },
  "phase": {
    "class_type": "KaggleH3PhaseDispatch",
    "inputs": {
      "model": ["h3_adapter", 0],
      "runtime_config": ["h3_adapter", 1],
      "conditioning": ["h3", 0],
      "latent_image": ["h3", 1]
    },
    "_meta": {"title": "Kaggle H3 | Transformer Dispatch Barrier"}
  },
  "sample": {
    "class_type": "KaggleH3TurboSampler",
    "inputs": {
      "model": ["phase", 0],
      "runtime_config": ["phase", 3],
      "conditioning": ["phase", 1],
      "latent_image": ["phase", 2],
      "noise_seed": 7,
      "sampler_name": "euler",
      "synchronize_mode": "full"
    },
    "_meta": {"title": "Kaggle H3 | Turbo Sampler (4 steps)"}
  },
  "decode": {
    "class_type": "KaggleH3VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["vae_video", 0],
      "device_id": 1,
      "runtime_config": ["h3_adapter", 1]
    },
    "_meta": {"title": "Kaggle H3 | Video Decode (GPU1)"}
  },
  "decode_audio": {
    "class_type": "KaggleH3AudioVAEDecode",
    "inputs": {
      "samples": ["sample", 1],
      "vae": ["vae_audio", 0],
      "device_id": 0,
      "runtime_config": ["h3_adapter", 1]
    },
    "_meta": {"title": "Kaggle H3 | Audio Decode (GPU0)"}
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode", 0],
      "fps": 24.0,
      "audio": ["decode_audio", 0],
      "bit_depth": 8,
      "color_space": "sRGB"
    },
    "_meta": {"title": "Output | Video + Audio"}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "kaggle_h3/kaggle_h3_turbo_smoke",
      "format": "mp4",
      "codec": "auto"
    },
    "_meta": {"title": "Output | Save Turbo Smoke Video"}
  }
}
