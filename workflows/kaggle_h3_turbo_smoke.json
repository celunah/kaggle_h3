{
  "unet": {
    "class_type": "KaggleH3ShardedDiffusionLoader",
    "inputs": {
      "model_variant": "Ref2VA",
      "model_profile": "singularity",
      "precision": "int8_convrot",
      "weight_dtype": "default",
      "gpu_0": 0,
      "gpu_1": 1
    },
    "_meta": {"title": "H3 Test Workflow | Singularity Ref2VA INT8 Auto Loader"}
  },
  "clip": {
    "class_type": "KaggleH3TextEncoderLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device_id": 0
    },
    "_meta": {"title": "H3 Test Workflow | Fixed Text Encoder (GPU0)"}
  },
  "vae_video": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors",
      "role": "video",
      "device_id": 1
    },
    "_meta": {"title": "H3 Test Workflow | Fixed Video VAE (GPU1)"}
  },
  "vae_audio": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors",
      "role": "audio",
      "device_id": 0
    },
    "_meta": {"title": "H3 Test Workflow | Fixed Audio VAE (GPU0)"}
  },
  "h3": {
    "class_type": "KaggleH3Conditioning",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "audio_vae": ["vae_audio", 0],
      "mode": "Ref2VA",
      "prompt": "Mode: Ref2VA. Preserve the same plain blue-shirted woman from <Picture 1> in the bright open field from <Picture 2>. She stands still and gently turns her head once in clear daylight. Keep the camera, face, shirt, blue sky, horizon, and field stable.",
      "seconds": 5.0,
      "size_preset": "360p",
      "aspect_ratio": "16:9",
      "ref_image_size": "match",
      "reference_0": "image",
      "reference_0.file": "CHARACTER_REFERENCE.png",
      "reference_1": "image",
      "reference_1.file": "SCENE_REFERENCE.png"
    },
    "_meta": {"title": "H3 Test Workflow | Fixed Ref2VA Prompt and References"}
  },
  "h3_adapter": {
    "class_type": "KaggleH3AdapterStack",
    "inputs": {
      "model": ["unet", 0],
      "model_variant": "ref2va",
      "turbo_mode": true,
      "turbo_steps": 4,
      "adapter_1": "auto_singularity_ref2va_turbo",
      "strength_1": 1.0,
      "adapter_2": "None",
      "strength_2": 1.0,
      "adapter_3": "None",
      "strength_3": 1.0,
      "conditioning_mode": "Ref2VA"
    },
    "_meta": {"title": "H3 Test Workflow | Matching Singularity Ref2VA Turbo LoRA"}
  },
  "core_bundle": {
    "class_type": "Bundle (obvpm)",
    "inputs": {
      "names": "model\nruntime_config\nconditioning\nlatent_image",
      "in_1": ["h3_adapter", 0],
      "in_2": ["h3_adapter", 1],
      "in_3": ["h3", 0],
      "in_4": ["h3", 1]
    },
    "_meta": {"title": "H3 Test Workflow | Bundle H3 Core Wires"}
  },
  "core_unbundle": {
    "class_type": "Unbundle (obvpm)",
    "inputs": {
      "in": ["core_bundle", 0],
      "names": "model\nruntime_config\nconditioning\nlatent_image"
    },
    "_meta": {"title": "H3 Test Workflow | Unbundle H3 Core Wires"}
  },
  "phase": {
    "class_type": "KaggleH3PhaseDispatch",
    "inputs": {
      "model": ["core_unbundle", 0],
      "runtime_config": ["core_unbundle", 1],
      "conditioning": ["core_unbundle", 2],
      "latent_image": ["core_unbundle", 3]
    },
    "_meta": {"title": "H3 Test Workflow | Dual-T4 Transformer Dispatch"}
  },
  "sample": {
    "class_type": "KaggleH3TurboSampler",
    "inputs": {
      "model": ["phase", 0],
      "runtime_config": ["phase", 3],
      "conditioning": ["phase", 1],
      "latent_image": ["phase", 2],
      "noise_seed": 7,
      "sampler_name": "euler",
      "steps": 4,
      "synchronize_mode": "full"
    },
    "_meta": {"title": "H3 Test Workflow | Fixed Euler, 4 Steps, Full Sync"}
  },
  "decode": {
    "class_type": "KaggleH3VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["vae_video", 0],
      "device_id": 1,
      "runtime_config": ["h3_adapter", 1]
    },
    "_meta": {"title": "H3 Test Workflow | Video Decode (GPU1)"}
  },
  "decode_audio": {
    "class_type": "KaggleH3AudioVAEDecode",
    "inputs": {
      "samples": ["sample", 1],
      "vae": ["vae_audio", 0],
      "device_id": 0,
      "mute_generated_audio": false,
      "runtime_config": ["h3_adapter", 1]
    },
    "_meta": {"title": "H3 Test Workflow | Audio Decode (GPU0)"}
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode", 0],
      "fps": 24.0,
      "audio": ["decode_audio", 0],
      "bit_depth": 8,
      "color_space": "sRGB"
    },
    "_meta": {"title": "H3 Test Workflow | Fixed Video + Audio"}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "kaggle_h3/h3_test",
      "format": "mp4",
      "codec": "auto"
    },
    "_meta": {"title": "H3 Test Workflow | Save Known-Good Smoke Video"}
  }
}
