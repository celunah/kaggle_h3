{
  "unet": {
    "class_type": "KaggleH3ShardedDiffusionLoader",
    "inputs": {
      "model_variant": "Ref2VA",
      "model_profile": "singularity",
      "precision": "int8_convrot",
      "weight_dtype": "default",
      "gpu_0": 0,
      "gpu_1": 1
    },
    "_meta": {"title": "Kaggle H3 | Singularity Ref2VA INT8 Auto Loader"}
  },
  "clip": {
    "class_type": "KaggleH3TextEncoderLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device_id": 0
    },
    "_meta": {"title": "Kaggle H3 | Text Encoder (GPU0)"}
  },
  "vae_video": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors",
      "role": "video",
      "device_id": 1
    },
    "_meta": {"title": "Kaggle H3 | Video VAE (GPU1)"}
  },
  "vae_audio": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors",
      "role": "audio",
      "device_id": 0
    },
    "_meta": {"title": "Kaggle H3 | Audio VAE (GPU0)"}
  },
  "h3": {
    "class_type": "KaggleH3Conditioning",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "audio_vae": ["vae_audio", 0],
      "mode": "Ref2VA",
      "prompt": "Mode: Ref2VA.\nPreserve the subject identity from <Picture 1> and the open-field composition from <Picture 2>.\nA short coherent video of the same woman in a plain blue shirt standing in a bright open grassy field during clear daytime. She makes only a small natural movement, gently turns her head, and shifts her weight while remaining in the same place. Keep the face, hair, shirt, bright daylight, blue sky, flat horizon, and simple field stable throughout. Use a mostly static camera and simple synchronized outdoor ambience.",
      "seconds": 5.0,
      "size_preset": "360p",
      "aspect_ratio": "16:9",
      "ref_image_size": "match",
      "reference_0": "image",
      "reference_0.file": "CHARACTER_REFERENCE.png",
      "reference_1": "image",
      "reference_1.file": "SCENE_REFERENCE.png"
    },
    "_meta": {"title": "Kaggle H3 | Global Conditioning (Ref2VA)"}
  },
  "h3_adapter": {
    "class_type": "KaggleH3AdapterStack",
    "inputs": {
      "model": ["unet", 0],
      "model_variant": "ref2va",
      "turbo_mode": true,
      "turbo_steps": 4,
      "adapter_1": "auto_singularity_ref2va_turbo",
      "strength_1": 1.0,
      "adapter_2": "None",
      "strength_2": 1.0,
      "adapter_3": "None",
      "strength_3": 1.0,
      "conditioning_mode": "Ref2VA"
    },
    "_meta": {"title": "Kaggle H3 | Turbo + Adapter Stack"}
  },
  "phase": {
    "class_type": "KaggleH3PhaseDispatch",
    "inputs": {
      "model": ["h3_adapter", 0],
      "runtime_config": ["h3_adapter", 1],
      "conditioning": ["h3", 0],
      "latent_image": ["h3", 1]
    },
    "_meta": {"title": "Kaggle H3 | Transformer Dispatch Barrier"}
  },
  "sample": {
    "class_type": "KaggleH3TurboSampler",
    "inputs": {
      "model": ["phase", 0],
      "runtime_config": ["phase", 3],
      "conditioning": ["phase", 1],
      "latent_image": ["phase", 2],
      "noise_seed": 7,
      "sampler_name": "euler",
      "steps": 4,
      "synchronize_mode": "full",
      "use_sage_attention": false
    },
    "_meta": {"title": "Kaggle H3 | Singularity Turbo Sampler (Euler; 4 steps)"}
  },
  "decode": {
    "class_type": "KaggleH3VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["vae_video", 0],
      "device_id": 1,
      "runtime_config": ["h3_adapter", 1]
    },
    "_meta": {"title": "Kaggle H3 | Video Decode (GPU1)"}
  },
  "decode_audio": {
    "class_type": "KaggleH3AudioVAEDecode",
    "inputs": {
      "samples": ["sample", 1],
      "vae": ["vae_audio", 0],
      "device_id": 0,
      "mute_generated_audio": false,
      "runtime_config": ["h3_adapter", 1]
    },
    "_meta": {"title": "Kaggle H3 | Audio Decode (GPU0)"}
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode", 0],
      "fps": 24.0,
      "audio": ["decode_audio", 0],
      "bit_depth": 8,
      "color_space": "sRGB"
    },
    "_meta": {"title": "Output | Video + Audio (mute available on audio decode)"}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "kaggle_h3/kaggle_h3_turbo_smoke",
      "format": "mp4",
      "codec": "auto"
    },
    "_meta": {"title": "Output | Save Turbo Smoke Video"}
  }
}
