{
  "unet": {
    "class_type": "KaggleH3ShardedDiffusionLoader",
    "inputs": {
      "model_variant": "FL2VA",
      "model_profile": "auto",
      "precision": "int8_convrot",
      "weight_dtype": "default",
      "gpu_0": 0,
      "gpu_1": 1
    },
    "_meta": {"title": "Kaggle H3 | Diffusion Auto Loader (FL2VA; auto official INT8)"}
  },
  "clip": {
    "class_type": "KaggleH3TextEncoderLoader",
    "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device_id": 0},
    "_meta": {"title": "Kaggle H3 | Text Encoder (GPU0)"}
  },
  "vae_video": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors", "role": "video", "device_id": 1},
    "_meta": {"title": "Kaggle H3 | Video VAE (GPU1)"}
  },
  "vae_audio": {
    "class_type": "KaggleH3VAELoader",
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors", "role": "audio", "device_id": 0},
    "_meta": {"title": "Kaggle H3 | Audio VAE (GPU0)"}
  },
  "h3": {
    "class_type": "KaggleH3Conditioning",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "mode": "FL2VA",
      "seconds": 5.0,
      "size_preset": "360p",
      "aspect_ratio": "16:9",
      "ref_image_size": "match",
      "prompt": "The subject moves continuously from the first frame composition to the last frame composition with stable identity.",
      "width": 608,
      "height": 352,
      "length": 124,
      "start_frame_file": "FIRST_FRAME.png",
      "end_frame_file": "LAST_FRAME.png"
    },
    "_meta": {"title": "Kaggle H3 | Global Conditioning (FL2VA)"}
  },
  "phase": {
    "class_type": "KaggleH3PhaseDispatch",
    "inputs": {"model": ["unet", 0], "conditioning": ["h3", 0], "latent_image": ["h3", 1]},
    "_meta": {"title": "Kaggle H3 | Transformer Dispatch Barrier"}
  },
  "sample": {
    "class_type": "KaggleH3TurboSampler",
    "inputs": {"model": ["phase", 0], "conditioning": ["phase", 1], "latent_image": ["phase", 2], "noise_seed": 42, "sampler_name": "res_multistep", "steps": 4, "synchronize_mode": "full", "sage_attention": false},
    "_meta": {"title": "Kaggle H3 | H3 Sampler"}
  },
  "decode": {"class_type": "KaggleH3VAEDecode", "inputs": {"samples": ["sample", 0], "vae": ["vae_video", 0], "device_id": 1}, "_meta": {"title": "Kaggle H3 | Video Decode (GPU1)"}},
  "decode_audio": {"class_type": "KaggleH3AudioVAEDecode", "inputs": {"samples": ["sample", 1], "vae": ["vae_audio", 0], "device_id": 0}, "_meta": {"title": "Kaggle H3 | Audio Decode (GPU0)"}},
  "video": {"class_type": "CreateVideo", "inputs": {"images": ["decode", 0], "fps": 24.0, "audio": ["decode_audio", 0], "bit_depth": 8, "color_space": "sRGB"}, "_meta": {"title": "Output | Video + Audio"}},
  "save": {"class_type": "SaveVideo", "inputs": {"video": ["video", 0], "filename_prefix": "kaggle_h3/fl2va", "format": "mp4", "codec": "auto"}, "_meta": {"title": "Output | Save FL2VA Video"}}
}
